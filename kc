#!/usr/bin/env bash

set -euo pipefail
IFS=$'\n\t'
VERBOSE=false
PF=false
# Utility jobs delete themselves this long after creation, even if kc never
# gets the chance to clean up (kill -9, crash, machine gone).
TTL=86400

