function print_command() {
    cmd=$@
    echo ""
    if [[ "$VERBOSE" == true ]]; then
        echo "> $cmd"
    fi
}

function check_dependencies() {
    local dependencies=("kubectl" "yq" "sed" "awk" "tr" "git" "grep" "xargs" "sort" "uniq")
    for dep in "${dependencies[@]}"; do
        if ! command -v "$dep" &> /dev/null; then
            echo "Error: $dep is not installed." >&2
            exit 1
        fi
    done
}

function switch_context() {
    local context="$1"
    if [[ -z "$context" ]]; then
        return 0
    fi

    local ctx=$(load_config | yq ".ctxs.$context")
    if [[ -n "$ctx" && "$ctx" != "null" ]]; then
        context="$ctx"
    fi

    local current_context=$(kubectl config current-context 2>/dev/null)
    if [[ "$context" == "$current_context" ]]; then
        return 0
    fi

    kubectl config use-context "$context"
}

function load_config() {
    local config_file="$(which kc | sed s/\\/kc$//g)/.kc/config.yaml"
    if [[ ! -f "$config_file" ]]; then
        echo "Config file '$config_file' not found." >&2
        exit 1
    fi
    yq "$config_file"
}

function validate_config() {
    local config=$(load_config)
    if [[ -z "$config" || "$config" == "null" ]]; then
        echo "Invalid config file '$config_file'." >&2
        exit 1
    fi

    local kube_contexts=$(kubectl config get-contexts -o name)
    local config_contexts=$(echo "$config" | yq ".ctxs | .[]")
    for ctx in $config_contexts; do
        if ! echo "$kube_contexts" | grep -q "$ctx"; then
            echo "Context '$ctx' not found in kubeconfig." >&2
            exit 1
        fi
    done

    local app_configs=$(echo "$config" | yq ".apps")
    for app_name in $(echo "$app_configs" | yq 'keys | .[]'); do
        app=$(echo "$app_configs" | yq ".\"$app_name\"")
        local deployment_name=$(echo "$app" | yq ".deployment")
        if [[ -z "$deployment_name" || "$deployment_name" == "null" ]]; then
            echo "app 'deployment' is missing for '$app_name'" >&2
            exit 1
        fi
        local namespace=$(echo "$app" | yq ".namespace")
        if [[ -z "$namespace" || "$namespace" == "null" ]]; then
            echo "app 'namespace' is missing for '$app_name'" >&2
            exit 1
        fi

        local pg_config=$(echo "$app" | yq ".pg")
        if [[ -n "$pg_config" && "$pg_config" != "null" ]]; then
            local pg_required_fields=("host" "user" "password" "dbname")
            for field in "${pg_required_fields[@]}"; do
                local field_value=$(echo "$pg_config" | yq ".$field")
                if [[ -z "$field_value" || "$field_value" == "null" ]]; then
                    echo "pg '$field' is missing for '$app_name'" >&2
                    exit 1
                fi
            done
        fi

        local mongo_config=$(echo "$app" | yq ".mongo")
        if [[ -n "$mongo_config" && "$mongo_config" != "null" ]]; then
            local mongo_required_fields=("host" "user" "password" "dbname")
            for field in "${mongo_required_fields[@]}"; do
                local field_value=$(echo "$mongo_config" | yq ".$field")
                if [[ -z "$field_value" || "$field_value" == "null" ]]; then
                    echo "mongo '$field' is missing for '$app_name'" >&2
                    exit 1
                fi
            done
        fi

        local redis_config=$(echo "$app" | yq ".redis")
        if [[ -n "$redis_config" && "$redis_config" != "null" ]]; then
            local redis_required_fields=("host")
            for field in "${redis_required_fields[@]}"; do
                local field_value=$(echo "$redis_config" | yq ".$field")
                if [[ -z "$field_value" || "$field_value" == "null" ]]; then
                    echo "redis '$field' is missing for '$app_name'" >&2
                    exit 1
                fi
            done
        fi
    done
}

function load_config_for_app() {
    local app_name="$1"
    local app_config=$(load_config | yq ".apps")

    echo "$app_config" | yq ".$app_name"
}

function resolve_config_for_subcommand() {
    local app_config="$1"
    local subcommand="$2"
    local ns=$(echo "$app_config" | yq ".namespace")

    echo "Fetching deployment information for app '$app_name' in namespace '$ns'..." >&2

    local subcommand_config=$(echo "$app_config" | yq ".$subcommand")
    local deployment_name=$(echo "$app_config" | yq ".deployment")
    local deployment=$(kubectl get deployment -n "$ns" -o yaml)
    if [[ -z "$deployment" || "$deployment" == "null" ]]; then
        echo "Deployment '$deployment_name' not found in namespace '$ns'." >&2
        exit 1
    fi
    local env_vars=$(echo "$deployment" | yq ".items | map(select(.metadata.name | test(\"$deployment_name\"))) | .[0].spec.template.spec.containers | map(select(.name | test (\"$deployment_name\"))) | .[0].env | map({.name:.value}) | .[]")
    while IFS=":" read -r key value; do
        key=$(echo "$key" | xargs)
        value=$(echo "$value" | xargs)

        resolved_value=$(echo "$env_vars" | yq ".$value")

        subcommand_config=$(echo "$subcommand_config" | sed "s/: $value/: $(printf '%s\n' "$resolved_value" | sed 's/[&/\]/\\&/g')/g")
    done <<< "$subcommand_config"

    echo "$subcommand_config"
}

function normalize_name() {
    local name="$1"
    local normalized_name=$(echo "$name" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9-]//g')
    echo "$normalized_name"
}

# All jobs created by this script are prefixed with "kc-" so they are
# easy to tell apart from real workloads (and easy to clean up).
function normalize_job_name() {
    echo "kc-$(normalize_name "$1")"
}

# activeDeadlineSeconds stops the job after $TTL, ttlSecondsAfterFinished then
# lets the cluster delete it. backoffLimit 0 keeps a failed pod from being
# replaced under an open session.
function create_job() {
    local jobname="$1"
    local ns="$2"
    local image="$3"
    local envs="${4:-}"
    local command="${5:-sleep $TTL}"

    kubectl delete job "$jobname" -n "$ns" --ignore-not-found=true

    local set_env="cat"
    if [[ -n "$envs" ]]; then
        set_env="kubectl set env --local -f - -o yaml $envs"
    fi

    cmd=$(echo "kubectl create job $jobname --image $image -n $ns --dry-run=client -o yaml -- $command | $set_env | yq '.spec.activeDeadlineSeconds = $TTL | .spec.ttlSecondsAfterFinished = 0 | .spec.backoffLimit = 0' | kubectl apply -f -")
    print_command "$cmd"
    eval $cmd

    wait_for_job "$jobname" "$ns"
}

# A job has no rollout status, so wait for its pod. The pod does not exist yet
# right after apply, so retry until it shows up.
function wait_for_job() {
    local jobname="$1"
    local ns="$2"
    local attempt=0

    cmd=$(echo "kubectl wait --for=condition=Ready pod -l job-name=$jobname -n $ns --timeout=10s")
    print_command "$cmd"
    while [[ $attempt -lt 30 ]]; do
        if eval $cmd &> /dev/null; then
            return 0
        fi
        attempt=$((attempt + 1))
        sleep 1
    done

    echo "Timed out waiting for job '$jobname' to be ready in namespace '$ns'." >&2
    exit 1
}

function job_pod() {
    local jobname="$1"
    local ns="$2"
    kubectl get pod -l job-name="$jobname" -n "$ns" -o jsonpath='{.items[0].metadata.name}'
}

function delete_job() {
    local jobname="$1"
    local ns="$2"
    kubectl delete job "$jobname" -n "$ns" --ignore-not-found=true
}

# Make sure the job is deleted even if the script is interrupted (Ctrl-C,
# terminal closed, kill) or exits with an error.
function delete_job_on_exit() {
    local jobname="$1"
    local ns="$2"
    trap "delete_job $jobname $ns" EXIT
    trap 'exit 130' INT
    trap 'exit 129' HUP
    trap 'exit 143' TERM
}

function connect_pg() {
    local git_user=$(git config --get user.name)
    local app_name=$1

    local app_config=$(load_config_for_app "$app_name")
    if [[ -z "$app_config" || "$app_config" == "null" ]]; then
        echo "No configuration found for app '$app_name' in config file." >&2
        exit 1
    fi
    local ns=$(echo "$app_config" | yq ".namespace")

    local config=$(resolve_config_for_subcommand "$app_config" "pg")
    if [[ -z "$config" || "$config" == "null" ]]; then
        echo "No pg configuration found for app '$app_name' in config file." >&2
        exit 1
    fi

    local host=$(echo "$config" | yq ".host")
    local port=$(echo "$config" | yq ".port")
    local user=$(echo "$config" | yq ".user")
    local password=$(echo "$config" | yq ".password")
    local dbname=$(echo "$config" | yq ".dbname")
    if [[ -z "$port" || "$port" == "null" ]]; then
        port="5432"
    fi

    local pfport=$(echo "$config" | yq ".pfport")
    if [[ -z "$pfport" || "$pfport" == "null" ]]; then
        pfport="15432"
    fi

    local jobname=$(normalize_job_name "util-pg-$app_name-$git_user")
    delete_job_on_exit "$jobname" "$ns"

    if [[ "$PF" == true ]]; then
        port_forward $jobname $ns $host $port $pfport
        return
    fi

    echo ""
    echo "Current context: $(kubectl config current-context)"
    echo "Connecting to PostgreSQL database using job: '$jobname' in ns: '$ns'..."
    create_job "$jobname" "$ns" "postgres:16" "PGPASSWORD=$password PGCONNECT_TIMEOUT=30"
    cmd=$(echo "kubectl exec -it job/$jobname -n $ns -- psql -U $user -h $host $dbname")
    print_command "$cmd"
    eval $cmd || true
}

function connect_mongo() {
    local git_user=$(git config --get user.name)
    local app_name=$1

    local app_config=$(load_config_for_app "$app_name")
    local ns=$(echo "$app_config" | yq ".namespace")

    local config=$(resolve_config_for_subcommand "$app_config" "mongo")
    if [[ -z "$config" || "$config" == "null" ]]; then
        echo "No mongo configuration found for app '$app_name' in config file." >&2
        exit 1
    fi

    local host=$(echo "$config" | yq ".host")
    local port=$(echo "$config" | yq ".port")
    local user=$(echo "$config" | yq ".user")
    local password=$(echo "$config" | yq ".password")
    local dbname=$(echo "$config" | yq ".dbname")

    # Split host and port if host contains ':'
    if [[ "$host" == *:* ]]; then
        IFS=':' read -r host port_from_host <<< "$host"
        host="$host"
        port="$port_from_host"
    fi
    # Set default port if not set
    if [[ -z "$port" || "$port" == "null" ]]; then
        port="27017"
    fi

    local pfport=$(echo "$config" | yq ".pfport")
    if [[ -z "$pfport" || "$pfport" == "null" ]]; then
        pfport="127017"
    fi

    local jobname=$(normalize_job_name "util-mongo-$app_name-$git_user")
    delete_job_on_exit "$jobname" "$ns"

    if [[ "$PF" == true ]]; then
        port_forward $jobname $ns $host $port $pfport
        return
    fi

    echo ""
    echo "Current context: $(kubectl config current-context)"
    echo "Connecting to MongoDB database using job: '$jobname' in ns: '$ns'..."
    create_job "$jobname" "$ns" "arunvelsriram/utils"
    cmd=$(echo "kubectl exec -it job/$jobname -n $ns -- mongosh --host $host --port $port -u $user -p $password $dbname")
    print_command "$cmd"
    eval $cmd || true
}

function connect_redis() {
    local git_user=$(git config --get user.name)
    local app_name=$1

    local app_config=$(load_config_for_app "$app_name")
    local ns=$(echo "$app_config" | yq ".namespace")

    local config=$(resolve_config_for_subcommand "$app_config" "redis")
    if [[ -z "$config" || "$config" == "null" ]]; then
        echo "No redis configuration found for app '$app_name' in config file." >&2
        exit 1
    fi
    local host=$(echo "$config" | yq ".host")
    host=$(echo "$host" | awk '{print $1}')
    host=$(echo "$host" | awk -F',' '{print $1}')
    local port=$(echo "$config" | yq ".port")
    local password=$(echo "$config" | yq ".password")

    if [[ "$host" == *:* ]]; then
        IFS=':' read -r host port_from_host <<< "$host"
        host="$host"
        port="$port_from_host"
    fi

    if [[ -z "$port" || "$port" == "null" ]]; then
        port="6379"
    fi

    local pfport=$(echo "$config" | yq ".pfport")
    if [[ -z "$pfport" || "$pfport" == "null" ]]; then
        pfport="16379"
    fi

    local jobname=$(normalize_job_name "util-redis-$app_name-$git_user")
    delete_job_on_exit "$jobname" "$ns"

    if [[ "$PF" == true ]]; then
        port_forward $jobname $ns $host $port $pfport
        return
    fi

    echo ""
    echo "Current context: $(kubectl config current-context)"
    echo "Connecting to Redis database using job: '$jobname' in ns: '$ns'..."
    create_job "$jobname" "$ns" "redis:latest" "REDISCLI_AUTH=$password"
    cmd=$(echo "kubectl exec -it job/$jobname -n $ns -- redis-cli -c -h $host -p $port")
    print_command "$cmd"
    eval $cmd || true
}

function connect_util() {
    local user=$(git config --get user.name)
    local ns=$1

    if [[ "$ns" =~ ^[0-9]+$ ]]; then
        ns="a$(printf '%06d' "$ns")"
    fi

    local jobname=$(normalize_job_name "util-$user")
    delete_job_on_exit "$jobname" "$ns"

    echo "Creating utility job: $jobname in namespace '$ns'..."
    create_job "$jobname" "$ns" "arunvelsriram/utils"
    cmd=$(echo "kubectl exec -it job/$jobname -n $ns -- bash")
    print_command "$cmd"
    eval $cmd || true
}

function port_forward() {
    local jobname=$1
    local ns=$2
    local host=$3
    local port=$4
    local pfport=$5

    create_job "$jobname" "$ns" "alpine/socat" "" "socat TCP4-LISTEN:$port,fork,reuseaddr TCP4:$host:$port"

    # port-forward does not accept job/<name>, so resolve the pod behind it
    local pod=$(job_pod "$jobname" "$ns")
    cmd=$(echo "kubectl port-forward -n $ns pod/$pod $pfport:$port")
    print_command "$cmd"
    eval $cmd
}

function cleanup() {
    local config=$(load_config)
    local user=$(git config --get user.name)
    user=$(normalize_name "$user")
    local contexts=$(echo "$config" | yq ".ctxs | .[]" 2>/dev/null || true)
    if [[ -z "$contexts" || "$contexts" == "null" ]]; then
        contexts=$(kubectl config current-context)
    fi
    local namespaces=$(echo "$config" | yq ".apps[].namespace" 2>/dev/null | sort | uniq)

    echo ""
    echo "Starting cleanup of utility jobs..."
    local pids=()  # Array to store background process IDs

    for ctx in $contexts; do
        switch_context "$ctx"
        for ns in $namespaces; do
            local jobs=$(kubectl get jobs -n "$ns" --no-headers -o custom-columns=":metadata.name" 2>/dev/null | grep -E "^(kc-)?util.*$user")
            if [[ -z "$jobs" ]]; then
                continue
            fi
            echo "ctx: $ctx, ns: $ns"
            for job in $jobs; do
                echo "  - Deleting $job (background)"
                kubectl delete job "$job" -n "$ns" --ignore-not-found=true &
                pids+=($!)
            done
        done
        echo ""
    done

    # Wait for all background deletions to complete
    if [[ ${#pids[@]} -gt 0 ]]; then
        echo "Waiting for ${#pids[@]} deletion(s) to complete..."
        for pid in "${pids[@]}"; do
            wait "$pid"
        done
        echo "All job deletions completed."
    fi
}

function first_namespace() {
    load_config | yq ".apps[].namespace" | head -n1
}

if [[ $# -eq 0 ]]; then
    show_help
    exit 0
fi

check_dependencies

# Parse option if provided
CONTEXT=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -c|--context)
            if [[ -n "${2:-}" ]]; then
                CONTEXT="$2"
                shift 2
            fi
            ;;
        -v|--verbose)
            VERBOSE=true
            shift
            ;;
        -pf|--port-forward)
            PF=true
            shift
            ;;
        *)
            if [[ "$1" == -* ]]; then
                CONTEXT="${1#-}"
                shift
            else
                break
            fi
            ;;
    esac
done

switch_context "$CONTEXT"

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    show_help
    exit 0
fi

if [[ -z "${1:-}" ]]; then
    exit 0
fi
case "$1" in
    pg)
        if [[ $# -ne 2 ]]; then
            show_help_pg
            exit 1
        fi
        connect_pg "$2"
        ;;
    mongo)
        if [[ $# -ne 2 ]]; then
            show_help_mongo
            exit 1
        fi
        connect_mongo "$2"
        ;;
    redis)
        if [[ $# -ne 2 ]]; then
            show_help_redis
            exit 1
        fi
        connect_redis "$2"
        ;;
    util)
        ns=$(first_namespace)
        if [[ $# -eq 2 ]]; then
            ns=$2
        fi

        connect_util "$ns"
        ;;
    cleanup)
        cleanup
        ;;
    help)
        if [[ $# -ne 2 ]]; then
            show_help
            exit 1
        fi
        case "$2" in
            pg)
                show_help_pg
                ;;
            mongo)
                show_help_mongo
                ;;
            redis)
                show_help_redis
                ;;
            util)
                show_help_util
                ;;
            *)
                show_help
                ;;
        esac
        ;;
    *)
        print_command "$@"
        "$@"
        ;;
esac
